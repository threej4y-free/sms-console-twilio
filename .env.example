NODE_ENV=development
PORT=3001

TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=seu_auth_token
TWILIO_PHONE_NUMBER=+15005550006

# Opcional: deixe usuario e token vazios para desativar a SMSFire.
SMSFIRE_USERNAME=
SMSFIRE_API_TOKEN=
SMSFIRE_BASE_URL=https://api-v3.smsfire.com.br

# Protege o POST /v1/messages. Gere um valor longo e aleatorio.
API_KEY=troque-por-uma-chave-segura

# URL HTTPS publica usada pela Twilio para enviar atualizacoes de status.
# Deixe vazia enquanto estiver trabalhando apenas localmente.
PUBLIC_BASE_URL=

# Em producao deve permanecer true.
TWILIO_VALIDATE_WEBHOOKS=true
